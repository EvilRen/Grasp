    { "name": "Smash", "short_name": "Smash", "description": "Smash walls, rooms and a little city", "url": "/smash", "icons": [{ "src": "/icons/shortcut-smash.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Shapes", "short_name": "Shapes", "description": "The shape sorter", "url": "/shapes", "icons": [{ "src": "/icons/shortcut-shapes.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Camera games", "short_name": "Camera", "description": "Air Drums, Bubble Pop, Air Painting, Catch the Stars", "url": "/?open=camera", "icons": [{ "src": "/icons/shortcut-camera.png", "sizes": "96x96", "type": "image/png" }] }
  ]
